<%layout("layout/boilerplate.ejs")%>

<!-- HERO SECTION -->

<section class="hero-section">

    <div class="hero-container">

        <!-- LEFT CONTENT -->

        <div class="hero-content">

            <span class="hero-tag">
                Welcome to Friends English Academy
            </span>

            <h1>
                Speak English With
                <span>Confidence.</span>
                Build Your Future.
            </h1>

            <p>
                Improve your English speaking, grammar, and communication skills with expert guidance. Learn from A1 (Beginner) to C2 (Proficient) levels, covering everything from basic to advanced English. Build confidence and achieve your personal and professional goals.
            </p>

            <div class="hero-buttons">

                <a href="/consulting" class="hero-btn">
                    Book Free Consultation
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="/about" class="hero-secondary-btn">
                    Learn More
                </a>

            </div>

        </div>

        <!-- RIGHT CONTENT -->

        <div class="hero-image">

            <div class="hero-image-box">
                <img src="/images/hero.jpg"
                     alt="English Learning at Friends English Academy">
            </div>

        </div>

    </div>

</section>

<!-- DYNAMIC ADMIN OFFERS -->
<% if (typeof activeOffers !== 'undefined' && activeOffers && activeOffers.length > 0) { %>
<section class="container my-5">
    <div class="text-center mb-4">
        <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2">
            <i class="fa-solid fa-fire me-1"></i> Limited Time Discounts
        </span>
        <h2 class="fw-bold text-dark">Special Offers from the Academy</h2>
        <p class="text-muted">Take advantage of current promotional discounts posted by our administration</p>
    </div>
    <div class="row g-4 justify-content-center">
        <% activeOffers.forEach(off => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-2 border-danger rounded-4 position-relative overflow-hidden p-3" style="background: #fff8f8; border-style: dashed !important;">
                    <span class="position-absolute top-0 end-0 bg-danger text-white px-3 py-1 rounded-bottom-start fw-bold small">
                        <%= off.badge || 'Special Offer' %>
                    </span>
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title fw-bold text-dark mt-2 mb-1"><%= off.title %></h4>
                        <div class="text-danger fw-bolder fs-4 mb-2"><%= off.discount %></div>
                        <p class="card-text text-secondary flex-grow-1"><%= off.description %></p>
                        
                        <% if (off.code) { %>
                            <div class="my-3 p-2 bg-white rounded text-center border">
                                <small class="text-muted d-block">Use Coupon Code</small>
                                <span class="fw-bold text-dark fs-5 font-monospace"><%= off.code %></span>
                            </div>
                        <% } %>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <small class="text-muted">
                                <i class="fa-regular fa-clock me-1"></i>
                                <%= off.validTill ? 'Valid: ' + off.validTill : 'Ongoing' %>
                            </small>
                            <a href="/consulting" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">
                                Claim Offer <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

