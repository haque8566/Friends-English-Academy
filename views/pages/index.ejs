<!-- 
COURSES -->


<section class="levels-section">

    <div class="section-heading">
        <span>YOUR LEARNING JOURNEY</span>
        <h2>Learn English from <span>Basic to Advanced</span></h2>
        <p>Start your English learning journey and improve your skills step by step.</p>
    </div>

    <div class="levels-container">

        <!-- A1 - A2 -->
        <div class="level-card">
            <div class="level-number">01</div>
            <h3>A1 - A2</h3>
            <h4>Beginner to Elementary</h4>
            <p>Build a strong foundation in English. Learn basic vocabulary, grammar and everyday communication.</p>
            <div class="level-tag">Basic English</div>
        </div>

        <!-- B1 - B2 -->
        <div class="level-card featured-level">
            <div class="level-number">02</div>
            <h3>B1 - B2</h3>
            <h4>Intermediate to Upper Intermediate</h4>
            <p>Improve your speaking fluency, grammar and confidence in everyday and professional conversations.</p>
            <div class="level-tag">Intermediate English</div>
        </div>

        <!-- C1 - C2 -->
        <div class="level-card">
            <div class="level-number">03</div>
            <h3>C1 - C2</h3>
            <h4>Advanced to Proficient</h4>
            <p>Develop advanced vocabulary, fluent communication and strong English proficiency.</p>
            <div class="level-tag">Advanced English</div>
        </div>

    </div>

    <!-- Course Fee -->
  

</section>



