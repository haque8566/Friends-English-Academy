<% layout("layout/boilerplate.ejs") %>

<section class="admin-section" style="margin-top: 100px;">
    <!-- Header -->
    <div class="admin-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="admin-badge"><i class="fa-solid fa-shield-halved me-1"></i> ADMIN PORTAL</span>
                
            </div>
            <h1 class="h3 fw-bold mb-1">Welcome, <%= currentUser.name %>!</h1>
            <p class="text-secondary mb-0">Control Center for Users, Offers, and Academy Inquiries</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="#tasks-pane" class="btn btn-warning text-dark rounded-pill px-3 fw-semibold shadow-sm" onclick="showTasksTab()">
                <i class="fa-solid fa-calendar-plus me-1"></i> Post Daily Task
            </a>
            <a href="#new-offer-card" class="btn btn-danger rounded-pill px-3 fw-semibold shadow-sm" onclick="showOffersTab()">
                <i class="fa-solid fa-plus me-1"></i> Create Offer
            </a>
            <a href="/practice/a1-a2" class="btn btn-outline-info rounded-pill px-3" target="_blank">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Student Practice Room
            </a>
            <a href="/" class="btn btn-outline-light rounded-pill px-3">
                <i class="fa-solid fa-globe me-1"></i> View Website
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon users">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="stat-num"><%= users.length %></div>
                    <div class="stat-label">Registered Users</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon offers">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <div class="stat-num"><%= offers.length %></div>
                    <div class="stat-label">Active / Total Offers</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon contacts">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <div>
                    <div class="stat-num"><%= contacts.length %></div>
                    <div class="stat-label">Contact Enquiries</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon consults">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                    <div class="stat-num"><%= consultings.length %></div>
                    <div class="stat-label">Consultation Bookings</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Navigation Tabs -->
    <ul class="nav nav-pills admin-tabs mb-4" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                <i class="fa-solid fa-user-check me-2 text-primary"></i> Users & Roles (<%= users.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tasks-tab" data-bs-toggle="pill" data-bs-target="#tasks-pane" type="button" role="tab">
                <i class="fa-solid fa-list-check me-2 text-warning"></i> Daily Tasks & Student Practice (<%= typeof tasks !== 'undefined' ? tasks.length : 0 %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="offers-tab" data-bs-toggle="pill" data-bs-target="#offers-pane" type="button" role="tab">
                <i class="fa-solid fa-fire me-2 text-danger"></i> Manage Offers (<%= offers.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="enquiries-tab" data-bs-toggle="pill" data-bs-target="#enquiries-pane" type="button" role="tab">
                <i class="fa-solid fa-inbox me-2 text-success"></i> &nbsp; Student Enquiries (<%= contacts.length + consultings.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="certificates-tab" data-bs-toggle="pill" data-bs-target="#certificates-pane" type="button" role="tab">
               <i class="fa-solid fa-award me-1" style="color: #ec4899;"></i> Certificates (<%= typeof certificates !== 'undefined' ? certificates.length : 0 %>)
            </button>
        </li>
    </ul>

    <!-- Tab Content Panes -->
    <div class="tab-content" id="adminTabContent">

        <!-- ======================= TAB 1: USERS & DIRECT LOGINS ======================= -->
        <div class="tab-pane fade show active" id="users-pane" role="tabpanel">
            <div class="admin-panel-card mb-4">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">
                            <i class="fa-solid fa-users-viewfinder text-primary me-2"></i> All Registered & Direct Logged-In Users
                        </h2>
                        
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                        Total Users: <%= users.length %>
                    </span>
                </div>

                <!-- Role Filter Buttons -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 pt-3 pb-2 border-bottom">
                    <div class="btn-group btn-group-sm" role="group" id="userRoleFilterGroup">
                        <button type="button" class="btn btn-primary active" onclick="filterUserRole('all', this)">
                            All (<%= users.length %>)
                        </button>
                        <button type="button" class="btn btn-outline-primary" onclick="filterUserRole('user', this)">
                            <i class="fa-solid fa-user me-1"></i> Users (<%= users.filter(u => u.role === 'user' || !u.role).length %>)
                        </button>
                        <button type="button" class="btn btn-outline-success" onclick="filterUserRole('student', this)">
                            <i class="fa-solid fa-graduation-cap me-1"></i> Students (<%= users.filter(u => u.role === 'student').length %>)
                        </button>
                        <button type="button" class="btn btn-outline-warning text-dark" onclick="filterUserRole('admin', this)">
                            <i class="fa-solid fa-shield-halved text-warning me-1"></i> Admins (<%= users.filter(u => u.role === 'admin').length %>)
                        </button>
                    </div>
                    <span class="text-muted small"><i class="fa-solid fa-circle-info text-primary me-1"></i> Select role from dropdown to assign instantly</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>User Profile</th>
                                <th>Contact Info</th>
                                <th>Role</th>
                                <th>Total Logins</th>
                                <th>Last Logged In</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (users && users.length > 0) { %>
                                <% users.forEach((u, index) => { %>
                                    <tr data-user-role="<%= u.role || 'user' %>">
                                        <td><span class="text-muted fw-bold"><%= index + 1 %></span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px; border: 1px solid #cbd5e1;">
                                                    <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark"><%= u.name %></div>
                                                    <small class="text-muted">Joined: <%= new Date(u.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= u.email %></div>
                                            <% if (u.phone) { %>
                                                <small class="text-muted"><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= u.phone %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (u.role === 'admin') { %>
                                                <span class="status-pill admin"><i class="fa-solid fa-shield-halved text-warning"></i> Admin</span>
                                            <% } else if (u.role === 'student') { %>
                                                <span class="status-pill student"><i class="fa-solid fa-graduation-cap text-success"></i> Student</span>
                                            <% } else { %>
                                                <span class="status-pill user"><i class="fa-solid fa-user text-primary"></i> User</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                <i class="fa-solid fa-right-to-bracket me-1"></i> <%= u.loginCount || 1 %> <%= (u.loginCount || 1) === 1 ? 'time' : 'times' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (u.lastLogin) { %>
                                                <div class="fw-semibold text-dark">
                                                    <%= new Date(u.lastLogin).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                </div>
                                                <small class="text-muted">
                                                    <%= new Date(u.lastLogin).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' }) %>
                                                </small>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">At registration</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (currentUser._id.toString() !== u._id.toString()) { %>
                                                <div class="d-flex align-items-center gap-2">
                                                    <!-- Role Selection (auto-submits on change) -->
                                                    <form action="/admin/users/<%= u._id %>/role" method="POST" class="d-inline">
                                                        <select name="role" class="form-select form-select-sm" style="width: 125px; font-weight: 500; border-radius: 20px; padding: 4px 10px;" onchange="this.form.submit()" title="Change Role">
                                                            <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>👤 User</option>
                                                            <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>🎓 Student</option>
                                                            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>🛡️ Admin</option>
                                                        </select>
                                                    </form>

                                                    <!-- Delete User Button -->
                                                    <form action="/admin/users/<%= u._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete <%= u.name %>? This action cannot be undone.');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;" title="Delete User">
                                                            <i class="fa-solid fa-trash-can" style="font-size: 12px;"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                                                    <i class="fa-solid fa-user-check me-1"></i> You (Current)
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No registered users found yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Login Activity Log -->
            <div class="admin-panel-card">
                <div class="panel-header">
                    <h3 class="panel-title fs-6 fw-bold">
                        <i class="fa-solid fa-clock-rotate-left text-danger me-2"></i> Recent Login Activity Stream
                    </h3>
                    <small class="text-muted">Last 10 user login events</small>
                </div>
                <div class="p-3">
                    <div class="list-group list-group-flush">
                        <% 
                            let recentLogins = [];
                            users.forEach(u => {
                                if (u.loginHistory && u.loginHistory.length > 0) {
                                    u.loginHistory.forEach(h => {
                                        recentLogins.push({
                                            name: u.name,
                                            email: u.email,
                                            role: u.role,
                                            time: h.loginAt,
                                            ip: h.ip
                                        });
                                    });
                                } else if (u.lastLogin) {
                                    recentLogins.push({
                                        name: u.name,
                                        email: u.email,
                                        role: u.role,
                                        time: u.lastLogin,
                                        ip: 'Localhost'
                                    });
                                }
                            });
                            recentLogins.sort((a, b) => new Date(b.time) - new Date(a.time));
                            recentLogins = recentLogins.slice(0, 10);
                        %>

                        <% if (recentLogins.length > 0) { %>
                            <% recentLogins.forEach(log => { %>
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-success-subtle p-2 text-success">
                                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= log.name %> (<%= log.email %>)</div>
                                            <small class="text-muted">Role: <span class="badge bg-light text-dark border"><%= log.role %></span></small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-semibold text-dark"><%= new Date(log.time).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                        <small class="text-muted"><%= new Date(log.time).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' }) %></small>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-3 text-muted">No login history recorded yet.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================= TAB 2: OFFERS MANAGEMENT ======================= -->
        <div class="tab-pane fade" id="offers-pane" role="tabpanel">
            <div class="row g-4">
                
                <!-- Create New Offer Form -->
                <div class="col-lg-5" id="new-offer-card">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <i class="fa-solid fa-circle-plus text-danger fs-5"></i>
                            <h3 class="panel-title">Post New Offer</h3>
                        </div>

                        <form action="/admin/offers" method="POST" class="needs-validation" novalidate>
                            
                            <!-- Offer Title -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Title *</label>
                                <input 
                                    type="text" 
                                    name="title" 
                                    class="form-control" 
                                    placeholder="e.g. Spoken English Mastery Batch" 
                                    minlength="3" 
                                    maxlength="100" 
                                    required
                                >
                                <div class="invalid-feedback">Title is required (min 3 chars).</div>
                            </div>

                            <!-- Discount Tag -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Discount Amount / Text *</label>
                                <input 
                                    type="text" 
                                    name="discount" 
                                    class="form-control" 
                                    placeholder="e.g. Flat 50% OFF or ₹2,000 Cashback" 
                                    minlength="2" 
                                    required
                                >
                                <div class="invalid-feedback">Please enter the discount percentage or amount.</div>
                            </div>

                            <!-- Coupon Code & Validity -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Coupon Code</label>
                                    <input 
                                        type="text" 
                                        name="code" 
                                        class="form-control text-uppercase" 
                                        placeholder="e.g. FLUENT50"
                                    >
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Valid Till</label>
                                    <input 
                                        type="text" 
                                        name="validTill" 
                                        class="form-control" 
                                        placeholder="e.g. 30 Nov 2026"
                                    >
                                </div>
                            </div>

                            <!-- Badge Tag -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Badge</label>
                                <input 
                                    type="text" 
                                    name="badge" 
                                    class="form-control" 
                                    placeholder="e.g. Limited Time Offer / Popular" 
                                    value="Special Offer"
                                >
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Description *</label>
                                <textarea 
                                    name="description" 
                                    class="form-control" 
                                    rows="3" 
                                    placeholder="Explain offer details, target batch, and benefits..." 
                                    minlength="5" 
                                    required
                                ></textarea>
                                <div class="invalid-feedback">Description must be at least 5 characters.</div>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-bullhorn me-1"></i> Publish Offer Now
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Offers Grid -->
                <div class="col-lg-7">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <h3 class="panel-title">
                                <i class="fa-solid fa-tags text-danger me-2"></i> Active & Published Offers (<%= offers.length %>)
                            </h3>
                            <span class="text-muted small">Visible on Website Homepage</span>
                        </div>

                        <% if (offers && offers.length > 0) { %>
                            <div class="row g-3">
                                <% offers.forEach(offer => { %>
                                    <div class="col-12">
                                        <div class="offer-card <%= offer.isActive ? 'active-offer' : '' %>">
                                            <span class="offer-badge"><%= offer.badge || 'Limited Time' %></span>
                                            
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div>
                                                    <span class="badge <%= offer.isActive ? 'bg-success' : 'bg-secondary' %> mb-2">
                                                        <%= offer.isActive ? '● Live on Site' : 'Paused' %>
                                                    </span>
                                                    <h4 class="h5 fw-bold text-dark mb-1"><%= offer.title %></h4>
                                                    <div class="text-danger fw-bold fs-5 mb-2"><%= offer.discount %></div>
                                                </div>

                                                <% if (offer.code) { %>
                                                    <div class="text-end">
                                                        <small class="text-muted d-block mb-1">Coupon Code</small>
                                                        <span class="offer-code"><%= offer.code %></span>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <p class="text-secondary small mb-3"><%= offer.description %></p>

                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                <small class="text-muted">
                                                    <% if (offer.validTill) { %>
                                                        <i class="fa-regular fa-clock me-1"></i> Valid till: <strong><%= offer.validTill %></strong>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-infinity me-1"></i> Ongoing
                                                    <% } %>
                                                </small>

                                                <div class="d-flex gap-2">
                                                    <!-- Toggle Active -->
                                                    <form action="/admin/offers/<%= offer._id %>/toggle" method="POST" class="d-inline">
                                                        <button type="submit" class="btn btn-sm <%= offer.isActive ? 'btn-outline-secondary' : 'btn-outline-success' %> rounded-pill px-3" title="Toggle Visibility">
                                                            <i class="fa-solid fa-power-off me-1"></i> <%= offer.isActive ? 'Pause' : 'Activate' %>
                                                        </button>
                                                    </form>

                                                    <!-- Delete Offer -->
                                                    <form action="/admin/offers/<%= offer._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this offer?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete Offer">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <div class="text-muted mb-3 fs-1"><i class="fa-solid fa-gift"></i></div>
                                <h5 class="fw-bold text-dark">No Offers Posted Yet</h5>
                                <p class="text-secondary small">Use the form on the left to post the academy's first discount offer!</p>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <!-- ======================= TAB 3: DAILY TASKS & STUDENT PRACTICE ======================= -->
        <div class="tab-pane fade" id="tasks-pane" role="tabpanel">
            
            <!-- Quick Sub-header & Monthly Student Attendance Report -->
            <div class="admin-panel-card p-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div>
                        <h3 class="panel-title mb-1">
                            <i class="fa-solid fa-calendar-check text-warning me-2"></i> Student Monthly Study Attendance & Practice Tracker
                        </h3>
                        <p class="text-muted small mb-0">Track how many days each student has actively practiced and completed tasks this month.</p>
                    </div>

                    <!-- Month Selector Form -->
                    <form action="/admin" method="GET" class="d-flex align-items-center gap-2">
                        <label class="form-label small fw-semibold mb-0 text-secondary">Month:</label>
                        <input type="month" name="month" class="form-control form-control-sm" value="<%= typeof selectedMonth !== 'undefined' ? selectedMonth : '' %>" onchange="this.form.submit()" style="width: 170px;">
                        <noscript><button type="submit" class="btn btn-sm btn-primary">Filter</button></noscript>
                    </form>
                </div>

                <!-- Monthly Attendance Table -->
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Enrolled Student</th>
                                <th>Days Studied (<%= typeof selectedMonth !== 'undefined' ? selectedMonth : 'Month' %>)</th>
                                <th>Tasks Done</th>
                                <th>Active Dates Logged</th>
                                <th>Last Active Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof studentAttendance !== 'undefined' && studentAttendance.length > 0) { %>
                                <% studentAttendance.forEach((sa, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= sa.name %></div>
                                            <small class="text-muted"><%= sa.email %></small>
                                            <% if (sa.phone) { %>
                                                <small class="text-muted d-block"><i class="fa-solid fa-phone me-1"></i> <%= sa.phone %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (sa.daysStudied > 0) { %>
                                                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                                                    <i class="fa-solid fa-fire me-1"></i> <%= sa.daysStudied %> Days
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                                                    0 Days (Inactive)
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <%= sa.tasksCount %> <%= sa.tasksCount === 1 ? 'task' : 'tasks' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (sa.daysList && sa.daysList.length > 0) { %>
                                                <div class="d-flex flex-wrap gap-1" style="max-width: 320px;">
                                                    <% sa.daysList.forEach(d => { %>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 11px;">
                                                            Day <%= parseInt(d.slice(8)) %>
                                                        </span>
                                                    <% }) %>
                                                </div>
                                            <% } else { %>
                                                <small class="text-muted fst-italic">No practice recorded yet</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (sa.lastActive) { %>
                                                <div class="fw-semibold text-dark"><%= new Date(sa.lastActive).toLocaleDateString("en-IN", { day: 'numeric', month: 'short' }) %></div>
                                                <small class="text-muted"><%= new Date(sa.lastActive).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' }) %></small>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No registered students yet. Assign the <strong>Student</strong> role to users from the Users tab!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Post Daily Task & Manage Tasks Row -->
            <div class="row g-4">
                
                <!-- Create New Task Form -->
                <div class="col-lg-5">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <i class="fa-solid fa-calendar-plus text-warning fs-5"></i>
                            <h3 class="panel-title">Post Daily Practice Task</h3>
                        </div>

                        <form action="/admin/tasks" method="POST" class="needs-validation" novalidate>
                            
                            <!-- Learning Level Selection -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Target Level *</label>
                                <select name="level" class="form-select" required>
                                    <option value="a1-a2">A1 – A2 (Beginner Level)</option>
                                    <option value="b1-b2">B1 – B2 (Intermediate Level)</option>
                                    <option value="c1-c2">C1 – C2 (Advanced Level)</option>
                                    <option value="all">All Levels (Common Challenge)</option>
                                </select>
                            </div>

                            <!-- Task Date & Category -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Practice Date *</label>
                                    <input type="date" name="date" class="form-control" value="<%= typeof todayDate !== 'undefined' ? todayDate : '' %>" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Category *</label>
                                    <select name="category" class="form-select" required>
                                        <option value="Speaking Practice">Speaking Practice</option>
                                        <option value="Grammar Rule">Grammar Rule</option>
                                        <option value="Vocabulary Builder">Vocabulary Builder</option>
                                        <option value="Daily Challenge" selected>Daily Challenge</option>
                                        <option value="Reading & Comprehension">Reading</option>
                                        <option value="Writing Task">Writing Task</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Task Title -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Task Title *</label>
                                <input 
                                    type="text" 
                                    name="title" 
                                    class="form-control" 
                                    placeholder="e.g. Day 18: Practice Daily Routine Sentences" 
                                    minlength="3" 
                                    required
                                >
                                <div class="invalid-feedback">Task title is required.</div>
                            </div>

                            <!-- Task Description / Instructions -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Instructions / Questions *</label>
                                <textarea 
                                    name="description" 
                                    class="form-control" 
                                    rows="4" 
                                    placeholder="Write today's task instructions, practice sentences, questions, or speaking topics..." 
                                    required
                                ></textarea>
                                <div class="invalid-feedback">Instructions are required.</div>
                            </div>

                            <!-- Checklist Items -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Checklist Items <small class="text-muted">(One per line - Optional)</small></label>
                                <textarea 
                                    name="checklist" 
                                    class="form-control" 
                                    rows="3" 
                                    placeholder="e.g.&#10;Read out loud 3 times&#10;Make 5 sentences with new words&#10;Record your voice speaking"
                                ></textarea>
                            </div>

                            <!-- Tips / Rule Note -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Helpful Tip / Rule <small class="text-muted">(Optional)</small></label>
                                <input 
                                    type="text" 
                                    name="hintOrResource" 
                                    class="form-control" 
                                    placeholder="e.g. Remember to use 's' or 'es' with he/she/it!"
                                >
                            </div>

                            <button type="submit" class="btn btn-warning text-dark w-100 rounded-pill py-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-paper-plane me-1"></i> Publish Daily Task Now
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Tasks Grid / Table -->
                <div class="col-lg-7">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <h3 class="panel-title">
                                <i class="fa-solid fa-list-check text-warning me-2"></i> Posted Daily Tasks (<%= typeof tasks !== 'undefined' ? tasks.length : 0 %>)
                            </h3>
                            <a href="/practice/a1-a2" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                View Practice Rooms <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                            </a>
                        </div>

                        <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover table-custom align-middle">
                                    <thead>
                                        <tr>
                                            <th>Date & Level</th>
                                            <th>Task Details</th>
                                            <th>Category</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% tasks.forEach(task => { %>
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark"><%= task.date %></div>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 11px;">
                                                        <%= task.level.toUpperCase() %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark"><%= task.title %></div>
                                                    <small class="text-secondary text-truncate d-block" style="max-width: 260px;">
                                                        <%= task.description %>
                                                    </small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border"><%= task.category %></span>
                                                </td>
                                                <td>
                                                    <form action="/admin/tasks/<%= task._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this task? All student completion records for it will also be deleted.');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="Delete Task">
                                                            <i class="fa-solid fa-trash-can" style="font-size: 11px;"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <div class="text-muted mb-2 fs-1"><i class="fa-solid fa-calendar-day"></i></div>
                                <h5 class="fw-bold text-dark">No Daily Tasks Posted Yet</h5>
                                <p class="text-secondary small">Use the form on the left to create daily practice tasks for A1-A2, B1-B2, and C1-C2 students!</p>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <!-- ======================= TAB 3: STUDENT ENQUIRIES ======================= -->
        <div class="tab-pane fade" id="enquiries-pane" role="tabpanel">
            <!-- Contact Form Inquiries -->
            <div class="admin-panel-card mb-4">
                <div class="panel-header">
                    <h3 class="panel-title">
                        <i class="fa-solid fa-address-book text-success me-2"></i> Contact Form Messages (<%= contacts.length %>)
                    </h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student</th>
                                <th>Phone</th>
                                <th>Course</th>
                                <th>Message</th>
                                <th>Received Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (contacts && contacts.length > 0) { %>
                                <% contacts.forEach((c, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <div class="fw-bold"><%= c.name %></div>
                                            <small class="text-muted"><%= c.email || 'No email provided' %></small>
                                        </td>
                                        <td><a href="tel:<%= c.phone %>" class="text-primary text-decoration-none fw-semibold"><i class="fa-solid fa-phone me-1"></i> <%= c.phone %></a></td>
                                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= c.course %></span></td>
                                        <td><small class="text-secondary"><%= c.message || 'No additional message' %></small></td>
                                        <td><small class="text-muted"><%= new Date(c.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No contact messages received yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Free Consultation Requests -->
            <div class="admin-panel-card">
                <div class="panel-header">
                    <h3 class="panel-title">
                        <i class="fa-solid fa-calendar-check text-warning me-2"></i> Free Consultation Bookings (<%= consultings.length %>)
                    </h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Level</th>
                                <th>Batch Timing</th>
                                <th>Goal / Notes</th>
                                <th>Booked On</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (consultings && consultings.length > 0) { %>
                                <% consultings.forEach((cs, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <div class="fw-bold"><%= cs.name %></div>
                                            <small class="text-muted"><%= cs.email || 'No email' %></small>
                                        </td>
                                        <td><a href="tel:<%= cs.phone %>" class="text-primary text-decoration-none fw-semibold"><i class="fa-solid fa-phone me-1"></i> <%= cs.phone %></a></td>
                                        <td><span class="badge bg-info-subtle text-info border"><%= cs.level %></span></td>
                                        <td><span class="badge bg-warning-subtle text-warning-emphasis border"><%= cs.timing %></span></td>
                                        <td><small class="text-secondary"><%= cs.message || 'General consultation' %></small></td>
                                        <td><small class="text-muted"><%= new Date(cs.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No consultation bookings received yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ======================= TAB 5: CERTIFICATES MANAGEMENT ======================= -->
        <div class="tab-pane fade" id="certificates-pane" role="tabpanel">
            <div class="admin-panel-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-2 border-bottom">
                    <div>
                        <h3 class="panel-title mb-1">
                            <i class="fa-solid fa-award text-primary me-2"></i> All Issued Student Certificates (<%= typeof certificates !== 'undefined' ? certificates.length : 0 %>)
                        </h3>
                        <p class="text-muted small mb-0">View, edit student details, assessment grades, or delete certificates.</p>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#issueCertModal">
                            <i class="fa-solid fa-plus me-1"></i> Issue New Certificate
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Certificate No.</th>
                                <th>Student Details</th>
                                <th>Course Level</th>
                                <th>Assessment Scores</th>
                                <th>Overall Grade</th>
                                <th>Awarded Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof certificates !== 'undefined' && certificates && certificates.length > 0) { %>
                                <% certificates.forEach((cert, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <span class="badge bg-light text-primary border fw-bold">
                                                <%= cert.certificateNo || 'FEA/SE/2026' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark fs-6"><%= cert.username %></div>
                                            <small class="text-muted">
                                                DOB: <strong><%= cert.dob ? new Date(cert.dob).toLocaleDateString("en-GB") : '-' %></strong>
                                            </small>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <%= cert.level %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small">
                                                <span title="Grammar">G: <strong><%= cert.grammar || '-' %></strong></span> · 
                                                <span title="Listening">L: <strong><%= cert.listening || '-' %></strong></span> · 
                                                <span title="Speaking">S: <strong><%= cert.speaking || '-' %></strong></span> · 
                                                <span title="Reading">R: <strong><%= cert.reading || '-' %></strong></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success fs-6 px-3 py-1 rounded-pill">
                                                <%= cert.overall %>
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                <%= cert.awardedDate ? new Date(cert.awardedDate).toLocaleDateString("en-GB", { day: 'numeric', month: 'short', year: 'numeric' }) : 'Recent' %>
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <!-- View Certificate -->
                                                <a href="/certificate/<%= cert._id %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="View & Download Certificate">
                                                    <i class="fa-solid fa-eye" style="font-size: 11px;"></i>
                                                </a>

                                                <!-- Edit Certificate (Modal trigger) -->
                                                <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" data-bs-toggle="modal" data-bs-target="#editCertModal<%= cert._id %>" title="Edit Certificate Details">
                                                    <i class="fa-solid fa-pen-to-square" style="font-size: 11px;"></i>
                                                </button>

                                                <!-- Delete Certificate -->
                                                <form action="/admin/certificates/<%= cert._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete certificate for <%= cert.username %>? This action cannot be undone.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="Delete Certificate">
                                                        <i class="fa-solid fa-trash-can" style="font-size: 11px;"></i>
                                                    </button>
                                                </form>
                                            </div>

                                            <!-- Edit Certificate Modal -->
                                            <div class="modal fade" id="editCertModal<%= cert._id %>" tabindex="-1" aria-labelledby="editCertModalLabel<%= cert._id %>" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    <div class="modal-content rounded-4 border-0 shadow">
                                                        <div class="modal-header border-bottom pb-3">
                                                            <h5 class="modal-title fw-bold" id="editCertModalLabel<%= cert._id %>">
                                                                <i class="fa-solid fa-pen-to-square text-warning me-2"></i> Edit Certificate (<%= cert.username %>)
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>

                                                        <form action="/admin/certificates/<%= cert._id %>/edit" method="POST">
                                                            <div class="modal-body p-4">
                                                                
                                                                <div class="row g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Student Full Name *</label>
                                                                        <input type="text" name="username" class="form-control" value="<%= cert.username %>" required>
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Certificate Number</label>
                                                                        <input type="text" name="certificateNo" class="form-control" value="<%= cert.certificateNo || '' %>">
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Course Level *</label>
                                                                        <input type="text" name="level" class="form-control" value="<%= cert.level %>" required>
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Date of Birth *</label>
                                                                        <input type="date" name="dob" class="form-control" value="<%= cert.dob ? new Date(cert.dob).toISOString().slice(0, 10) : '' %>" required>
                                                                    </div>

                                                                    <div class="col-12 mt-3">
                                                                        <h6 class="fw-bold text-secondary border-bottom pb-2">Assessment Results (CEFR)</h6>
                                                                    </div>

                                                                    <div class="col-sm-6 col-md-3">
                                                                        <label class="form-label small fw-semibold">Grammar &amp; Vocab</label>
                                                                        <select name="grammar" class="form-select">
                                                                            <% ['A1','A2','B1','B2','C1','C2'].forEach(lvl => { %>
                                                                                <option value="<%= lvl %>" <%= cert.grammar === lvl ? 'selected' : '' %>><%= lvl %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-sm-6 col-md-3">
                                                                        <label class="form-label small fw-semibold">Listening</label>
                                                                        <select name="listening" class="form-select">
                                                                            <% ['A1','A2','B1','B2','C1','C2'].forEach(lvl => { %>
                                                                                <option value="<%= lvl %>" <%= cert.listening === lvl ? 'selected' : '' %>><%= lvl %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-sm-6 col-md-3">
                                                                        <label class="form-label small fw-semibold">Speaking</label>
                                                                        <select name="speaking" class="form-select">
                                                                            <% ['A1','A2','B1','B2','C1','C2'].forEach(lvl => { %>
                                                                                <option value="<%= lvl %>" <%= cert.speaking === lvl ? 'selected' : '' %>><%= lvl %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-sm-6 col-md-3">
                                                                        <label class="form-label small fw-semibold">Reading</label>
                                                                        <select name="reading" class="form-select">
                                                                            <% ['A1','A2','B1','B2','C1','C2'].forEach(lvl => { %>
                                                                                <option value="<%= lvl %>" <%= cert.reading === lvl ? 'selected' : '' %>><%= lvl %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-md-6 mt-3">
                                                                        <label class="form-label fw-semibold">Overall CEFR Level *</label>
                                                                        <select name="overall" class="form-select" required>
                                                                            <% ['A1','A2','B1','B2','C1','C2'].forEach(lvl => { %>
                                                                                <option value="<%= lvl %>" <%= cert.overall === lvl ? 'selected' : '' %>><%= lvl %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-md-6 mt-3">
                                                                        <label class="form-label fw-semibold">Duration</label>
                                                                        <input type="text" name="duration" class="form-control" value="<%= cert.duration || '13 Weeks' %>">
                                                                    </div>
                                                                </div>

                                                            </div>
                                                            <div class="modal-footer border-top pt-3">
                                                                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Changes</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-award fs-1 mb-2 d-block text-secondary"></i>
                                        No certificates issued yet. Click <strong>Issue New Certificate</strong> above to issue one!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Issue New Certificate Modal -->
                <div class="modal fade" id="issueCertModal" tabindex="-1" aria-labelledby="issueCertModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content rounded-4 border-0 shadow">
                            <div class="modal-header border-bottom pb-3 bg-light">
                                <h5 class="modal-title fw-bold" id="issueCertModalLabel">
                                    <i class="fa-solid fa-award text-primary me-2"></i> Issue New Student Certificate
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <form action="/admin/certificates/generate" method="POST">
                                <div class="modal-body p-4">

                                    <div class="alert alert-info py-2 small mb-3">
                                        <i class="fa-solid fa-circle-info me-1"></i> As Admin, certificates generated here will be officially recorded with an automatic serial number (e.g. <code>FEA/SE/2026/001</code>) and downloadable by the student.
                                    </div>

                                    <div class="row g-3">
                                        <!-- Link to Registered User / Student -->
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Link to Enrolled Student / User <small class="text-muted">(Optional - auto-links to their student account)</small></label>
                                            <select name="userId" id="issueCertUserSelect" class="form-select" onchange="fillStudentDetails(this)">
                                                <option value="">-- Choose registered student or type name below --</option>
                                                <% if (typeof users !== 'undefined' && users) { %>
                                                    <% users.forEach(u => { %>
                                                        <option value="<%= u._id %>" data-name="<%= u.name %>"><%= u.name %> (<%= u.email %>) [<%= u.role.toUpperCase() %>]</option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>

                                        <!-- Student Full Name -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Student Full Name *</label>
                                            <input type="text" name="username" id="issueCertUsername" class="form-control" placeholder="e.g. Mohd Iftekhar Shaikh" required>
                                        </div>

                                        <!-- Date of Birth -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Date of Birth (DOB) *</label>
                                            <input type="date" name="dob" class="form-control" required>
                                        </div>

                                        <!-- Course Level -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Course Level *</label>
                                            <select name="level" class="form-select" required>
                                                <option value="A1 - B1 LEVEL" selected>A1 - B1 LEVEL (Beginner to Elementary)</option>
                                                <option value="B1 - B2 LEVEL">B1 - B2 LEVEL (Intermediate to Upper-Intermediate)</option>
                                                <option value="C1 - C2 LEVEL">C1 - C2 LEVEL (Advanced to Mastery)</option>
                                            </select>
                                        </div>

                                        <!-- Course Name -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Course Title</label>
                                            <input type="text" name="courseName" class="form-control" value="Spoken English Programme">
                                        </div>

                                        <!-- Duration -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Programme Duration</label>
                                            <input type="text" name="duration" class="form-control" value="13 Weeks">
                                        </div>

                                        <!-- Awarded Date -->
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Awarded Date</label>
                                            <input type="date" name="awardedDate" class="form-control" value="<%= typeof todayDate !== 'undefined' ? todayDate : '' %>">
                                        </div>

                                        <!-- Assessment CEFR Scores -->
                                        <div class="col-12 mt-3">
                                            <h6 class="fw-bold text-secondary border-bottom pb-2">CEFR Assessment Results</h6>
                                        </div>

                                        <div class="col-sm-6 col-md-3">
                                            <label class="form-label small fw-semibold">Grammar &amp; Vocab *</label>
                                            <select name="grammar" class="form-select" required>
                                                <option value="A1">A1</option>
                                                <option value="A2">A2</option>
                                                <option value="B1" selected>B1</option>
                                                <option value="B2">B2</option>
                                                <option value="C1">C1</option>
                                                <option value="C2">C2</option>
                                            </select>
                                        </div>

                                        <div class="col-sm-6 col-md-3">
                                            <label class="form-label small fw-semibold">Listening *</label>
                                            <select name="listening" class="form-select" required>
                                                <option value="A1">A1</option>
                                                <option value="A2" selected>A2</option>
                                                <option value="B1">B1</option>
                                                <option value="B2">B2</option>
                                                <option value="C1">C1</option>
                                                <option value="C2">C2</option>
                                            </select>
                                        </div>

                                        <div class="col-sm-6 col-md-3">
                                            <label class="form-label small fw-semibold">Speaking *</label>
                                            <select name="speaking" class="form-select" required>
                                                <option value="A1">A1</option>
                                                <option value="A2" selected>A2</option>
                                                <option value="B1">B1</option>
                                                <option value="B2">B2</option>
                                                <option value="C1">C1</option>
                                                <option value="C2">C2</option>
                                            </select>
                                        </div>

                                        <div class="col-sm-6 col-md-3">
                                            <label class="form-label small fw-semibold">Reading *</label>
                                            <select name="reading" class="form-select" required>
                                                <option value="A1">A1</option>
                                                <option value="A2" selected>A2</option>
                                                <option value="B1">B1</option>
                                                <option value="B2">B2</option>
                                                <option value="C1">C1</option>
                                                <option value="C2">C2</option>
                                            </select>
                                        </div>

                                        <div class="col-12 mt-3">
                                            <label class="form-label fw-semibold">Overall CEFR Level *</label>
                                            <select name="overall" class="form-select" required>
                                                <option value="A1">A1</option>
                                                <option value="A2" selected>A2</option>
                                                <option value="B1">B1</option>
                                                <option value="B2">B2</option>
                                                <option value="C1">C1</option>
                                                <option value="C2">C2</option>
                                            </select>
                                        </div>

                                    </div>

                                </div>
                                <div class="modal-footer border-top pt-3 bg-light">
                                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                                        <i class="fa-solid fa-award me-1"></i> Issue Certificate Now
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
function showOffersTab() {
    const offersTab = document.getElementById('offers-tab');
    if (offersTab) {
        bootstrap.Tab.getOrCreateInstance(offersTab).show();
    }
}

function showTasksTab() {
    const tasksTab = document.getElementById('tasks-tab');
    if (tasksTab) {
        bootstrap.Tab.getOrCreateInstance(tasksTab).show();
    }
}

function showCertificatesTab() {
    const certsTab = document.getElementById('certificates-tab');
    if (certsTab) {
        bootstrap.Tab.getOrCreateInstance(certsTab).show();
    }
}

function fillStudentDetails(select) {
    if (!select) return;
    const selectedOption = select.options[select.selectedIndex];
    if (selectedOption) {
        const name = selectedOption.getAttribute('data-name');
        if (name) {
            const input = document.getElementById('issueCertUsername');
            if (input) input.value = name;
        }
    }
}

// Auto open tab based on URL hash
document.addEventListener("DOMContentLoaded", function () {
    const hash = window.location.hash;
    if (hash === '#tasks-pane' || hash.includes('tasks')) {
        showTasksTab();
    } else if (hash === '#certificates-pane' || hash.includes('cert')) {
        showCertificatesTab();
    } else if (hash === '#offers-pane' || hash.includes('offer')) {
        showOffersTab();
    }
});

function filterUserRole(role, btn) {
    const rows = document.querySelectorAll('#users-pane tbody tr[data-user-role]');
    rows.forEach(row => {
        if (role === 'all' || row.getAttribute('data-user-role') === role) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });

    const buttons = document.querySelectorAll('#userRoleFilterGroup .btn');
    buttons.forEach(b => {
        b.classList.remove('active');
        if (b.classList.contains('btn-primary')) {
            b.classList.replace('btn-primary', 'btn-outline-primary');
        }
    });
    btn.classList.add('active');
    if (btn.classList.contains('btn-outline-primary')) {
        btn.classList.replace('btn-outline-primary', 'btn-primary');
    }
}
</script>
