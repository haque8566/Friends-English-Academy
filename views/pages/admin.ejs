<% layout("layout/boilerplate.ejs") %>

<section class="admin-section" style="margin-top: 100px;">
    <!-- Header -->
    <div class="admin-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="admin-badge"><i class="fa-solid fa-shield-halved me-1"></i> ADMIN PORTAL</span>
                <span class="badge bg-secondary">System v1.0</span>
            </div>
            <h1 class="h3 fw-bold mb-1">Welcome, <%= currentUser.name %>!</h1>
            <p class="text-secondary mb-0">Control Center for Users, Offers, and Academy Inquiries</p>
        </div>
        <div class="d-flex gap-2">
            <a href="#new-offer-card" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm" onclick="showOffersTab()">
                <i class="fa-solid fa-plus me-1"></i> Create New Offer
            </a>
            <a href="/" class="btn btn-outline-light rounded-pill px-3">
                <i class="fa-solid fa-globe me-1"></i> View Website
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon users">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="stat-num"><%= users.length %></div>
                    <div class="stat-label">Registered Users</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon offers">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <div class="stat-num"><%= offers.length %></div>
                    <div class="stat-label">Active / Total Offers</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon contacts">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <div>
                    <div class="stat-num"><%= contacts.length %></div>
                    <div class="stat-label">Contact Enquiries</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon consults">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                    <div class="stat-num"><%= consultings.length %></div>
                    <div class="stat-label">Consultation Bookings</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Navigation Tabs -->
    <ul class="nav nav-pills admin-tabs mb-4" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                <i class="fa-solid fa-user-check me-2 text-primary"></i> Direct Logins & Users (<%= users.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="offers-tab" data-bs-toggle="pill" data-bs-target="#offers-pane" type="button" role="tab">
                <i class="fa-solid fa-fire me-2 text-danger"></i> Manage Offers (<%= offers.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="enquiries-tab" data-bs-toggle="pill" data-bs-target="#enquiries-pane" type="button" role="tab">
                <i class="fa-solid fa-inbox me-2 text-success"></i> Student Enquiries (<%= contacts.length + consultings.length %>)
            </button>
        </li>
    </ul>

    <!-- Tab Content Panes -->
    <div class="tab-content" id="adminTabContent">

        <!-- ======================= TAB 1: USERS & DIRECT LOGINS ======================= -->
        <div class="tab-pane fade show active" id="users-pane" role="tabpanel">
            <div class="admin-panel-card mb-4">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">
                            <i class="fa-solid fa-users-viewfinder text-primary me-2"></i> All Registered & Direct Logged-In Users
                        </h2>
                        
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                        Total Users: <%= users.length %>
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>User Profile</th>
                                <th>Contact Info</th>
                                <th>Role</th>
                                <th>Total Logins</th>
                                <th>Last Logged In</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (users && users.length > 0) { %>
                                <% users.forEach((u, index) => { %>
                                    <tr>
                                        <td><span class="text-muted fw-bold"><%= index + 1 %></span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px; border: 1px solid #cbd5e1;">
                                                    <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark"><%= u.name %></div>
                                                    <small class="text-muted">Joined: <%= new Date(u.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= u.email %></div>
                                            <% if (u.phone) { %>
                                                <small class="text-muted"><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= u.phone %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (u.role === 'admin') { %>
                                                <span class="status-pill admin"><i class="fa-solid fa-shield text-warning"></i> Admin</span>
                                            <% } else { %>
                                                <span class="status-pill user"><i class="fa-solid fa-user text-primary"></i> <%=u.role%></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                <i class="fa-solid fa-right-to-bracket me-1"></i> <%= u.loginCount || 1 %> <%= (u.loginCount || 1) === 1 ? 'time' : 'times' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (u.lastLogin) { %>
                                                <div class="fw-semibold text-dark">
                                                    <%= new Date(u.lastLogin).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                </div>
                                                <small class="text-muted">
                                                    <%= new Date(u.lastLogin).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' }) %>
                                                </small>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">At registration</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (currentUser._id.toString() !== u._id.toString()) { %>
                                               <form action="/admin/users/<%= u._id %>/toggle-role" method="POST" class="d-inline">
                                                  
                                                      <button type="submit"
                                                              class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                                              title="Switch User Role">

                                                             <i class="fa-solid fa-arrows-rotate me-1"></i>
                                                  
                                                          <% if (u.role === 'admin') { %>
                                                              Make User
                                                          <% } else if (u.role === 'user') { %>
                                                              Make Student
                                                          <% } else {
                                                          %>
                                                              Make Admin
                                                          <% } %>
                                                  
                                                      </button>
                                                  
                                                  </form>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">You (Current)</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No registered users found yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Login Activity Log -->
            <div class="admin-panel-card">
                <div class="panel-header">
                    <h3 class="panel-title fs-6 fw-bold">
                        <i class="fa-solid fa-clock-rotate-left text-danger me-2"></i> Recent Login Activity Stream
                    </h3>
                    <small class="text-muted">Last 10 user login events</small>
                </div>
                <div class="p-3">
                    <div class="list-group list-group-flush">
                        <% 
                            let recentLogins = [];
                            users.forEach(u => {
                                if (u.loginHistory && u.loginHistory.length > 0) {
                                    u.loginHistory.forEach(h => {
                                        recentLogins.push({
                                            name: u.name,
                                            email: u.email,
                                            role: u.role,
                                            time: h.loginAt,
                                            ip: h.ip
                                        });
                                    });
                                } else if (u.lastLogin) {
                                    recentLogins.push({
                                        name: u.name,
                                        email: u.email,
                                        role: u.role,
                                        time: u.lastLogin,
                                        ip: 'Localhost'
                                    });
                                }
                            });
                            recentLogins.sort((a, b) => new Date(b.time) - new Date(a.time));
                            recentLogins = recentLogins.slice(0, 10);
                        %>

                        <% if (recentLogins.length > 0) { %>
                            <% recentLogins.forEach(log => { %>
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-success-subtle p-2 text-success">
                                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= log.name %> (<%= log.email %>)</div>
                                            <small class="text-muted">Role: <span class="badge bg-light text-dark border"><%= log.role %></span></small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-semibold text-dark"><%= new Date(log.time).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                        <small class="text-muted"><%= new Date(log.time).toLocaleTimeString("en-IN", { hour: '2-digit', minute: '2-digit' }) %></small>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-3 text-muted">No login history recorded yet.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================= TAB 2: OFFERS MANAGEMENT ======================= -->
        <div class="tab-pane fade" id="offers-pane" role="tabpanel">
            <div class="row g-4">
                
                <!-- Create New Offer Form -->
                <div class="col-lg-5" id="new-offer-card">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <i class="fa-solid fa-circle-plus text-danger fs-5"></i>
                            <h3 class="panel-title">Post New Offer</h3>
                        </div>

                        <form action="/admin/offers" method="POST" class="needs-validation" novalidate>
                            
                            <!-- Offer Title -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Title *</label>
                                <input 
                                    type="text" 
                                    name="title" 
                                    class="form-control" 
                                    placeholder="e.g. Spoken English Mastery Batch" 
                                    minlength="3" 
                                    maxlength="100" 
                                    required
                                >
                                <div class="invalid-feedback">Title is required (min 3 chars).</div>
                            </div>

                            <!-- Discount Tag -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Discount Amount / Text *</label>
                                <input 
                                    type="text" 
                                    name="discount" 
                                    class="form-control" 
                                    placeholder="e.g. Flat 50% OFF or ₹2,000 Cashback" 
                                    minlength="2" 
                                    required
                                >
                                <div class="invalid-feedback">Please enter the discount percentage or amount.</div>
                            </div>

                            <!-- Coupon Code & Validity -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Coupon Code</label>
                                    <input 
                                        type="text" 
                                        name="code" 
                                        class="form-control text-uppercase" 
                                        placeholder="e.g. FLUENT50"
                                    >
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Valid Till</label>
                                    <input 
                                        type="text" 
                                        name="validTill" 
                                        class="form-control" 
                                        placeholder="e.g. 30 Nov 2026"
                                    >
                                </div>
                            </div>

                            <!-- Badge Tag -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Badge</label>
                                <input 
                                    type="text" 
                                    name="badge" 
                                    class="form-control" 
                                    placeholder="e.g. Limited Time Offer / Popular" 
                                    value="Special Offer"
                                >
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Offer Description *</label>
                                <textarea 
                                    name="description" 
                                    class="form-control" 
                                    rows="3" 
                                    placeholder="Explain offer details, target batch, and benefits..." 
                                    minlength="5" 
                                    required
                                ></textarea>
                                <div class="invalid-feedback">Description must be at least 5 characters.</div>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-bullhorn me-1"></i> Publish Offer Now
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Offers Grid -->
                <div class="col-lg-7">
                    <div class="admin-panel-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <h3 class="panel-title">
                                <i class="fa-solid fa-tags text-danger me-2"></i> Active & Published Offers (<%= offers.length %>)
                            </h3>
                            <span class="text-muted small">Visible on Website Homepage</span>
                        </div>

                        <% if (offers && offers.length > 0) { %>
                            <div class="row g-3">
                                <% offers.forEach(offer => { %>
                                    <div class="col-12">
                                        <div class="offer-card <%= offer.isActive ? 'active-offer' : '' %>">
                                            <span class="offer-badge"><%= offer.badge || 'Limited Time' %></span>
                                            
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div>
                                                    <span class="badge <%= offer.isActive ? 'bg-success' : 'bg-secondary' %> mb-2">
                                                        <%= offer.isActive ? '● Live on Site' : 'Paused' %>
                                                    </span>
                                                    <h4 class="h5 fw-bold text-dark mb-1"><%= offer.title %></h4>
                                                    <div class="text-danger fw-bold fs-5 mb-2"><%= offer.discount %></div>
                                                </div>

                                                <% if (offer.code) { %>
                                                    <div class="text-end">
                                                        <small class="text-muted d-block mb-1">Coupon Code</small>
                                                        <span class="offer-code"><%= offer.code %></span>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <p class="text-secondary small mb-3"><%= offer.description %></p>

                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                <small class="text-muted">
                                                    <% if (offer.validTill) { %>
                                                        <i class="fa-regular fa-clock me-1"></i> Valid till: <strong><%= offer.validTill %></strong>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-infinity me-1"></i> Ongoing
                                                    <% } %>
                                                </small>

                                                <div class="d-flex gap-2">
                                                    <!-- Toggle Active -->
                                                    <form action="/admin/offers/<%= offer._id %>/toggle" method="POST" class="d-inline">
                                                        <button type="submit" class="btn btn-sm <%= offer.isActive ? 'btn-outline-secondary' : 'btn-outline-success' %> rounded-pill px-3" title="Toggle Visibility">
                                                            <i class="fa-solid fa-power-off me-1"></i> <%= offer.isActive ? 'Pause' : 'Activate' %>
                                                        </button>
                                                    </form>

                                                    <!-- Delete Offer -->
                                                    <form action="/admin/offers/<%= offer._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this offer?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete Offer">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <div class="text-muted mb-3 fs-1"><i class="fa-solid fa-gift"></i></div>
                                <h5 class="fw-bold text-dark">No Offers Posted Yet</h5>
                                <p class="text-secondary small">Use the form on the left to post the academy's first discount offer!</p>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

        <!-- ======================= TAB 3: STUDENT ENQUIRIES ======================= -->
        <div class="tab-pane fade" id="enquiries-pane" role="tabpanel">
            <!-- Contact Form Inquiries -->
            <div class="admin-panel-card mb-4">
                <div class="panel-header">
                    <h3 class="panel-title">
                        <i class="fa-solid fa-address-book text-success me-2"></i> Contact Form Messages (<%= contacts.length %>)
                    </h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student</th>
                                <th>Phone</th>
                                <th>Course</th>
                                <th>Message</th>
                                <th>Received Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (contacts && contacts.length > 0) { %>
                                <% contacts.forEach((c, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <div class="fw-bold"><%= c.name %></div>
                                            <small class="text-muted"><%= c.email || 'No email provided' %></small>
                                        </td>
                                        <td><a href="tel:<%= c.phone %>" class="text-primary text-decoration-none fw-semibold"><i class="fa-solid fa-phone me-1"></i> <%= c.phone %></a></td>
                                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= c.course %></span></td>
                                        <td><small class="text-secondary"><%= c.message || 'No additional message' %></small></td>
                                        <td><small class="text-muted"><%= new Date(c.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No contact messages received yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Free Consultation Requests -->
            <div class="admin-panel-card">
                <div class="panel-header">
                    <h3 class="panel-title">
                        <i class="fa-solid fa-calendar-check text-warning me-2"></i> Free Consultation Bookings (<%= consultings.length %>)
                    </h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Level</th>
                                <th>Batch Timing</th>
                                <th>Goal / Notes</th>
                                <th>Booked On</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (consultings && consultings.length > 0) { %>
                                <% consultings.forEach((cs, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td>
                                            <div class="fw-bold"><%= cs.name %></div>
                                            <small class="text-muted"><%= cs.email || 'No email' %></small>
                                        </td>
                                        <td><a href="tel:<%= cs.phone %>" class="text-primary text-decoration-none fw-semibold"><i class="fa-solid fa-phone me-1"></i> <%= cs.phone %></a></td>
                                        <td><span class="badge bg-info-subtle text-info border"><%= cs.level %></span></td>
                                        <td><span class="badge bg-warning-subtle text-warning-emphasis border"><%= cs.timing %></span></td>
                                        <td><small class="text-secondary"><%= cs.message || 'General consultation' %></small></td>
                                        <td><small class="text-muted"><%= new Date(cs.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No consultation bookings received yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
function showOffersTab() {
    const offersTab = document.getElementById('offers-tab');
    if (offersTab) {
        bootstrap.Tab.getOrCreateInstance(offersTab).show();
    }
}
</script>
