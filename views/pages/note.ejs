<% layout("layout/boilerplate.ejs") %>

<section class="notes-section" style="margin-top: 10px;">

    <!-- Heading -->
    <div class="notes-heading">
        <span>LEARNING RESOURCES</span>
        <h1>English <span>Notes & Tests</span></h1>
        <p>
            Learn English step by step with level-wise study notes
            and practice tests.
        </p>
    </div>

    <!-- Notes Cards -->
    <div class="notes-container">

        <!-- A1-A2 -->
        <div class="notes-card">

            <div class="notes-icon">
                <i class="fa-solid fa-book-open"></i>
            </div>

            <span class="level-badge">BEGINNER LEVEL</span>

            <h2>A1 – A2</h2>
            <h3>Basic English</h3>

            <p>
                Start learning English from the basics.
                Improve your vocabulary, grammar and everyday communication.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Basic Grammar</span>
                <span><i class="fa-solid fa-check"></i> Daily Use Vocabulary</span>
                <span><i class="fa-solid fa-check"></i> Simple Sentences</span>
                <span><i class="fa-solid fa-check"></i> Basic Conversation</span>
            </div>

            <div class="notes-buttons">
                <a href="#" class="notes-btn">
                    <i class="fa-solid fa-book"></i>
                    Study Notes
                </a>

                <a href="#" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Practice Test
                </a>
            </div>

        </div>


        <!-- B1-B2 -->
        <div class="notes-card featured-card">

            <div class="notes-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <span class="level-badge">INTERMEDIATE LEVEL</span>

            <h2>B1 – B2</h2>
            <h3>Intermediate English</h3>

            <p>
                Improve your English fluency, understand complex grammar
                and communicate confidently in different situations.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Advanced Grammar</span>
                <span><i class="fa-solid fa-check"></i> Vocabulary Building</span>
                <span><i class="fa-solid fa-check"></i> Speaking Practice</span>
                <span><i class="fa-solid fa-check"></i> Reading & Writing</span>
            </div>

            <div class="notes-buttons">
                <a href="#" class="notes-btn">
                    <i class="fa-solid fa-book"></i>
                    Study Notes
                </a>

                <a href="#" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Practice Test
                </a>
            </div>

        </div>


        <!-- C1-C2 -->
        <div class="notes-card">

            <div class="notes-icon">
                <i class="fa-solid fa-award"></i>
            </div>

            <span class="level-badge">ADVANCED LEVEL</span>

            <h2>C1 – C2</h2>
            <h3>Advanced English</h3>

            <p>
                Master advanced English communication, express complex
                ideas and develop a high level of language proficiency.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Advanced Vocabulary</span>
                <span><i class="fa-solid fa-check"></i> Complex Grammar</span>
                <span><i class="fa-solid fa-check"></i> Fluent Communication</span>
                <span><i class="fa-solid fa-check"></i> Professional Writing</span>
            </div>

            <div class="notes-buttons">
                <a href="#" class="notes-btn">
                    <i class="fa-solid fa-book"></i>
                    Study Notes
                </a>

                <a href="#" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Practice Test
                </a>
            </div>

        </div>

    </div>

</section>