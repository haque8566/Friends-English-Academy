<% layout("layout/boilerplate.ejs") %>

<% if (typeof user !== 'undefined' && user && (user.role === 'student' || user.role === 'admin')) { %>

<section class="notes-section" style="margin-top: 10px;">

    <!-- Heading -->
    <div class="notes-heading">
        <span>LEARNING RESOURCES</span>
        <h1>English <span>Notes & Daily Practice</span></h1>
        <p>
            Learn English step by step with level-wise study notes,
            daily practice tasks, and monthly study tracking.
        </p>
        <div class="mt-3">
            <a href="/practice/a1-a2" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="fa-solid fa-calendar-check me-2"></i> Open Today's Daily Practice & Tasks
            </a>
        </div>
    </div>

    <!-- Notes Cards -->
    <div class="notes-container">

        <!-- A1-A2 -->
        <div class="notes-card">

            <div class="notes-icon">
                <i class="fa-solid fa-book-open"></i>
            </div>

            <span class="level-badge">BEGINNER LEVEL</span>

            <h2>A1 – A2</h2>
            <h3>Basic English</h3>

            <p>
                Start learning English from the basics.
                Improve your vocabulary, grammar and everyday communication.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Basic Grammar</span>
                <span><i class="fa-solid fa-check"></i> Daily Use Vocabulary</span>
                <span><i class="fa-solid fa-check"></i> Simple Sentences</span>
                <span><i class="fa-solid fa-check"></i> Basic Conversation</span>
            </div>

            <div class="notes-buttons">
                <a href="/practice/a1-a2" class="notes-btn" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white;">
                    <i class="fa-solid fa-calendar-day"></i>
                    Daily Practice
                </a>

                <a href="/practice/a1-a2" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Today's Task
                </a>
            </div>

        </div>


        <!-- B1-B2 -->
        <div class="notes-card featured-card">

            <div class="notes-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <span class="level-badge">INTERMEDIATE LEVEL</span>

            <h2>B1 – B2</h2>
            <h3>Intermediate English</h3>

            <p>
                Improve your English fluency, understand complex grammar
                and communicate confidently in different situations.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Advanced Grammar</span>
                <span><i class="fa-solid fa-check"></i> Vocabulary Building</span>
                <span><i class="fa-solid fa-check"></i> Speaking Practice</span>
                <span><i class="fa-solid fa-check"></i> Reading & Writing</span>
            </div>

            <div class="notes-buttons">
                <a href="/practice/b1-b2" class="notes-btn" style="background: linear-gradient(135deg, #dc2626, #b91c1c); color: white;">
                    <i class="fa-solid fa-calendar-day"></i>
                    Daily Practice
                </a>

                <a href="/practice/b1-b2" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Today's Task
                </a>
            </div>

        </div>


        <!-- C1-C2 -->
        <div class="notes-card">

            <div class="notes-icon">
                <i class="fa-solid fa-award"></i>
            </div>

            <span class="level-badge">ADVANCED LEVEL</span>

            <h2>C1 – C2</h2>
            <h3>Advanced English</h3>

            <p>
                Master advanced English communication, express complex
                ideas and develop a high level of language proficiency.
            </p>

            <div class="notes-topics">
                <span><i class="fa-solid fa-check"></i> Advanced Vocabulary</span>
                <span><i class="fa-solid fa-check"></i> Complex Grammar</span>
                <span><i class="fa-solid fa-check"></i> Fluent Communication</span>
                <span><i class="fa-solid fa-check"></i> Professional Writing</span>
            </div>

            <div class="notes-buttons">
                <a href="/practice/c1-c2" class="notes-btn" style="background: linear-gradient(135deg, #7c3aed, #6d28d9); color: white;">
                    <i class="fa-solid fa-calendar-day"></i>
                    Daily Practice
                </a>

                <a href="/practice/c1-c2" class="test-btn">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Today's Task
                </a>
            </div>

        </div>

    </div>

</section>


<% } else { %>

   

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 65vh; margin-top: 50px;">

    <div class="card border-0 shadow-lg text-center p-4"
         style="max-width: 480px; width: 100%; border-radius: 20px;">

        <div class="mb-3">
            <i class="fa-solid fa-lock"
               style="font-size: 55px; color: #ed1c24;"></i>
        </div>

        <h3 class="fw-bold mb-2">Student Access Only</h3>

        <p class="text-muted mb-4">
            English Notes & Tests are specially available for registered
            students of Friends English Academy.
            Join our academy to unlock all learning materials.
        </p>

        <div class="d-grid gap-2">

            <a href="/contact" class="btn btn-danger rounded-pill py-2">
                <i class="fa-solid fa-graduation-cap me-2"></i>
                Connect us
            </a>

            <a href="/" class="btn btn-outline-secondary rounded-pill py-2">
                Back to Home
            </a>

        </div>

        <small class="text-muted mt-3">
            <i class="fa-solid fa-shield-halved me-1"></i>
            Exclusive learning resources for students
        </small>

    </div>

</div>



<% } %>