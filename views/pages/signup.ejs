<% layout("layout/boilerplate.ejs") %>

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <span>Join Friends English Academy</span>
            <h1>Create Account</h1>
            <p>Start learning English fluently today</p>
        </div>

        <div class="auth-body">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                
                <!-- Full Name -->
                <div class="form-group mb-3">
                    <label for="name" class="form-label">Full Name *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-user text-muted"></i></span>
                        <input 
                            type="text" 
                            class="form-control" 
                            id="name" 
                            name="name" 
                            placeholder="Enter your full name" 
                            minlength="2" 
                            maxlength="60" 
                            required
                        >
                        <div class="invalid-feedback">
                            Please provide your full name (at least 2 characters).
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="form-group mb-3">
                    <label for="email" class="form-label">Email Address *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input 
                            type="email" 
                            class="form-control" 
                            id="email" 
                            name="email" 
                            placeholder="name@example.com" 
                            required
                        >
                        <div class="invalid-feedback">
                            Please provide a valid email address.
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="form-group mb-3">
                    <label for="phone" class="form-label">Mobile Number *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-phone text-muted"></i></span>
                        <input 
                            type="tel" 
                            class="form-control" 
                            id="phone" 
                            name="phone" 
                            placeholder="10-digit mobile number" 
                            pattern="[6-9][0-9]{9}" 
                            maxlength="10" 
                            inputmode="numeric" 
                            required
                        >
                        <div class="invalid-feedback">
                            Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9.
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group mb-3">
                    <label for="password" class="form-label">Password *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input 
                            type="password" 
                            class="form-control" 
                            id="password" 
                            name="password" 
                            placeholder="Create a strong password (min 6 chars)" 
                            minlength="6" 
                            maxlength="32" 
                            required
                        >
                        <div class="invalid-feedback">
                            Password must be at least 6 characters long.
                        </div>
                        <div class="valid-feedback">Strong password!</div>
                    </div>
                </div>

                <!-- Admin Passcode (Optional) -->
                <div class="form-group mb-4">
                    <label for="adminSecret" class="form-label d-flex justify-content-between align-items-center">
                        <span>Admin Secret Key <small class="text-muted">(Optional)</small></span>
                        <span class="badge bg-light text-dark border">For Staff / Admin</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-key text-muted"></i></span>
                        <input 
                            type="password" 
                            class="form-control" 
                            id="adminSecret" 
                            name="adminSecret" 
                            placeholder="Enter key if registering as Admin (e.g. admin123)"
                        >
                    </div>
                    <small class="text-muted d-block mt-1">Leave empty if you are a student/general user.</small>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-submit">
                    <i class="fa-solid fa-user-plus me-2"></i> Register Now
                </button>

            </form>

            <div class="auth-footer">
                Already have an account? <a href="/signin">Sign In here</a>
            </div>
        </div>
    </div>
</section>
