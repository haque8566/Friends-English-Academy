<% layout("layout/boilerplate.ejs") %>

<div class="container my-5 py-5 text-center">
    <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 600px; border-radius: 18px;">
        <div class="mb-3">
            <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2 rounded-pill fw-bold">
                Error <%= statusCode || 500 %>
            </span>
        </div>
        <h1 class="display-6 fw-bold text-dark mb-3">Oops! Something went wrong</h1>
        <p class="text-secondary mb-4 fs-6">
            <%= message || "We could not find the page you are looking for, or an unexpected error occurred." %>
        </p>
        <div>
            <a href="/" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
                <i class="fa-solid fa-house me-2"></i> Return to Homepage
            </a>
        </div>
    </div>
</div>
