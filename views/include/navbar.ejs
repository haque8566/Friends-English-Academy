<nav class="navbar">

   <div class="logo">
    <a href="/">
        <img src="/images/logo.png" alt="Friends English Academy Logo">
    </a>
</div>

    <button class="menu-toggle" id="menuToggle"
        aria-label="Toggle Menu"
        aria-expanded="false">

        <span></span>
        <span></span>
        <span></span>

    </button>

    <div class="nav-links" id="navLinks">

        <a href="/" class="anchor">Home</a>
        

        <a href="/contact" class="anchor">Contact us</a>

        <a href="/about" class="anchor">About</a>
      
  
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <span class="anchor user-greeting" style="color: #60a5fa; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-circle-user"></i> <%= currentUser.name ? currentUser.name.split(' ')[0] : 'User' %>
                
