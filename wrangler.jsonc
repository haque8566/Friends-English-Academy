{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friends-english-academy",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "build": {
    "command": "node scripts/compile-views.js"
  },
  "alias": {
    "ejs-mate": "./util/cf-ejs-engine.js",
    "ejs": "./util/cf-ejs-engine.js"
  }
}
